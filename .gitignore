__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# smoke artefacts (NB_SMOKE=1)
notebooks/out_smoke/
notebooks/tables_smoke/

# Run trees are rebuilt, not versioned.  The exceptions below are the record sets
# the notebooks would otherwise spend GPU-hours regenerating, plus the handful of
# trajectory slabs their figures read -- a full run adds ~2 GB of slabs here, and
# those stay ignored.
outputs/*
!outputs/matched_bench/
!outputs/pancreas_band/
!outputs/pancreas_noise/
!outputs/pancreas_review/
!outputs/pancreas_review_hw/
!outputs/erythroid_review/

!outputs/erythroid_bench/
outputs/erythroid_bench/*
!outputs/erythroid_bench/test/
!outputs/erythroid_bench/trajectories/
outputs/erythroid_bench/trajectories/*
!outputs/erythroid_bench/trajectories/d2_*_s0.npz

!outputs/itracer_bench/
outputs/itracer_bench/*
!outputs/itracer_bench/tuned/
!outputs/itracer_bench/trajectories/
outputs/itracer_bench/trajectories/*
!outputs/itracer_bench/trajectories/tuned_d2_*_s0.npz
